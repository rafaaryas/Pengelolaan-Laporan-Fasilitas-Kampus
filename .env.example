# Salin menjadi .env lalu isi password unik. Jangan commit .env.
# Spring Boot TIDAK membaca file ini otomatis. Gunakan scripts/dev.ps1.
# Nilai literal tanpa tanda kutip, substitusi variabel, atau komentar inline.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pelaporan_fasilitas
DB_USERNAME=kampus_app
DB_PASSWORD=CHANGE_ME_unique_database_password
SERVER_PORT=8080
DEMO_MAHASISWA_PASSWORD=CHANGE_ME_unique_mahasiswa_password
DEMO_ADMIN_PASSWORD=CHANGE_ME_unique_admin_password
DEMO_PETUGAS_PASSWORD=CHANGE_ME_unique_petugas_password
# Hanya diperlukan jika memilih Docker Compose (port host biasanya 3307).
MYSQL_ROOT_PASSWORD=CHANGE_ME_unique_container_root_password
